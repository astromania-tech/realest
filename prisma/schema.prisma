/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model waitlist {
  id                                                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                          String                  @unique @db.VarChar(255)
  first_name                                                     String                  @db.VarChar(100)
  last_name                                                      String?                 @db.VarChar(100)
  phone                                                          String?                 @db.VarChar(20)
  source                                                         String?                 @default("website") @db.VarChar(50)
  status                                                         String?                 @default("active") @db.VarChar(20)
  interests                                                      String[]
  location_preference                                            String?                 @db.VarChar(100)
  property_type_preference                                       String?                 @db.VarChar(50)
  budget_range                                                   String?                 @db.VarChar(50)
  subscribed_at                                                  DateTime?               @default(now()) @db.Timestamptz(6)
  unsubscribed_at                                                DateTime?               @db.Timestamptz(6)
  last_contacted_at                                              DateTime?               @db.Timestamptz(6)
  contact_count                                                  Int?                    @default(0)
  referrer_url                                                   String?
  user_agent                                                     String?
  ip_address                                                     String?                 @db.Inet
  utm_source                                                     String?                 @db.VarChar(100)
  utm_medium                                                     String?                 @db.VarChar(100)
  utm_campaign                                                   String?                 @db.VarChar(100)
  /// Auto-generated unique invite code, e.g. "A3F9B2C1"
  referral_code                                                  String?                 @unique @db.VarChar(20)
  /// UUID of the waitlist entry whose referral_code was used at signup
  referred_by                                                    String?                 @db.Uuid
  /// Cached count of successful referrals (incremented atomically)
  referral_count                                                 Int?                    @default(0)
  created_at                                                     DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at                                                     DateTime?               @default(now()) @db.Timestamptz(6)
  persona                                                        String                  @default("buyer_renter")
  persona_details                                                Json?
  queue_score                                                    Int                     @default(0)
  queue_rank                                                     Int?
  candidate_role                                                 String?
  poll_completion_count                                          Int                     @default(0)
  waitlist_reward_eligible                                       Boolean                 @default(false)
  referral_events_referral_events_referred_waitlist_idTowaitlist referral_events[]       @relation("referral_events_referred_waitlist_idTowaitlist")
  referral_events_referral_events_referrer_waitlist_idTowaitlist referral_events[]       @relation("referral_events_referrer_waitlist_idTowaitlist")
  reward_entitlements                                            reward_entitlements[]
  referrer                                                       waitlist?               @relation("WaitlistReferrals", fields: [referred_by], references: [id])
  referrals                                                      waitlist[]              @relation("WaitlistReferrals")
  waitlist_rank_history                                          waitlist_rank_history[]

  @@index([email], map: "idx_waitlist_email")
  @@index([location_preference], map: "idx_waitlist_location_preference")
  @@index([referral_code], map: "idx_waitlist_referral_code")
  @@index([referred_by], map: "idx_waitlist_referred_by")
  @@index([source], map: "idx_waitlist_source")
  @@index([status], map: "idx_waitlist_status")
  @@index([subscribed_at], map: "idx_waitlist_subscribed_at")
}

/// Anonymous poll votes collected from email links (e.g. city preference polls).
model poll_responses {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Identifies the poll question, e.g. 'city'
  question_key String
  /// The selected answer, e.g. 'Lagos'
  answer       String
  /// Campaign reference tag, e.g. 'frontier' | 'milestone'
  ref          String?
  ip_address   String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([question_key], map: "idx_poll_responses_question_key")
  @@index([answer], map: "idx_poll_responses_answer")
  @@index([created_at(sort: Desc)], map: "idx_poll_responses_created_at")
}

/// Persona-segmented launch intelligence poll catalog (form container).
model poll_forms {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String             @unique
  title       String
  description String?
  is_active   Boolean            @default(true)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @default(now()) @db.Timestamptz(6)
  questions   poll_questions[]
  submissions poll_submissions[]
}

/// Questions belonging to a poll form, keyed by segment.
model poll_questions {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id       String     @db.Uuid
  question_key  String
  segment       String
  prompt        String
  question_type String
  options       Json?
  is_required   Boolean    @default(true)
  display_order Int
  show_if       String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)
  form          poll_forms @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@unique([form_id, question_key])
  @@index([form_id, segment, display_order], map: "poll_questions_form_segment_idx")
}

/// A single respondent's poll submission (one per person per form).
model poll_submissions {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id              String                    @db.Uuid
  segment              String
  full_name            String
  email                String
  opt_in_email_results Boolean                   @default(false)
  referral_code        String?
  source               String                    @default("web")
  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  answers              poll_submission_answers[]
  form                 poll_forms                @relation(fields: [form_id], references: [id])

  @@index([form_id, segment], map: "poll_submissions_form_segment_idx")
  @@index([email])
}

/// Individual answers for each question within a submission.
model poll_submission_answers {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String           @db.Uuid
  question_key  String
  answer        Json
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  submission    poll_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_key])
  @@index([submission_id], map: "poll_submission_answers_submission_idx")
  @@index([question_key])
}

/// Email marketing campaign records — tracks both Resend broadcast and DB-segment batch sends.
model email_campaigns {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  template_name    String
  subject          String
  /// 'resend_audience' → Resend Broadcasts API | 'db_segment' → Resend Batch API
  audience_type    String
  /// Resend audience UUID (only for resend_audience type)
  audience_id      String?
  /// JSON filter object for DB-segment queries, e.g. { "role": "owner" }
  audience_filter  Json?
  /// 'broadcast' → Resend Broadcasts API | 'batch' → Resend Batch API
  send_mode        String
  /// 'draft' | 'scheduled' | 'sending' | 'sent' | 'failed' | 'cancelled'
  status           String    @default("draft")
  /// Serialised template props used when rendering — stored so preview is reproducible
  template_props   Json?
  scheduled_at     DateTime? @db.Timestamptz(6)
  sent_at          DateTime? @db.Timestamptz(6)
  total_recipients Int?      @default(0)
  sent_count       Int?      @default(0)
  failed_count     Int?      @default(0)
  /// Resend broadcast ID or first batch message ID for reference
  resend_id        String?
  created_by       String    @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  profiles         profiles  @relation(fields: [created_by], references: [id])

  @@index([status], map: "idx_email_campaigns_status")
  @@index([created_by], map: "idx_email_campaigns_created_by")
  @@index([created_at(sort: Desc)], map: "idx_email_campaigns_created_at")
}

model property_validation_jobs {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id           String     @db.Uuid
  job_kind              String     @default("property")
  source                String     @default("admin_validation")
  status                String     @default("queued")
  attempts              Int        @default(0)
  retry_count           Int        @default(0)
  last_error            String?
  failure_reason        String?
  final_property_status String?
  queued_at             DateTime   @default(now()) @db.Timestamptz(6)
  started_at            DateTime?  @db.Timestamptz(6)
  finished_at           DateTime?  @db.Timestamptz(6)
  updated_at            DateTime   @default(now()) @db.Timestamptz(6)
  next_retry_at         DateTime?  @db.Timestamptz(6)
  request_payload       Json?
  result                Json?
  requested_by          String?    @db.Uuid
  properties            properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?     @relation(fields: [requested_by], references: [id], onUpdate: NoAction)

  @@index([job_kind], map: "idx_property_validation_jobs_job_kind")
  @@index([next_retry_at], map: "idx_property_validation_jobs_next_retry_at", where: raw("(next_retry_at IS NOT NULL)"))
  @@index([property_id], map: "idx_property_validation_jobs_property_id")
  @@index([queued_at(sort: Desc)], map: "idx_property_validation_jobs_queued_at")
  @@index([status], map: "idx_property_validation_jobs_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model referral_events {
  id                                                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrer_waitlist_id                                    String?   @db.Uuid
  referrer_profile_id                                     String?   @db.Uuid
  referred_waitlist_id                                    String?   @db.Uuid
  referred_profile_id                                     String?   @db.Uuid
  referral_code                                           String?
  event_type                                              String
  metadata                                                Json      @default("{}")
  created_at                                              DateTime  @default(now()) @db.Timestamptz(6)
  profiles_referral_events_referred_profile_idToprofiles  profiles? @relation("referral_events_referred_profile_idToprofiles", fields: [referred_profile_id], references: [id], onUpdate: NoAction)
  waitlist_referral_events_referred_waitlist_idTowaitlist waitlist? @relation("referral_events_referred_waitlist_idTowaitlist", fields: [referred_waitlist_id], references: [id], onUpdate: NoAction)
  profiles_referral_events_referrer_profile_idToprofiles  profiles? @relation("referral_events_referrer_profile_idToprofiles", fields: [referrer_profile_id], references: [id], onUpdate: NoAction)
  waitlist_referral_events_referrer_waitlist_idTowaitlist waitlist? @relation("referral_events_referrer_waitlist_idTowaitlist", fields: [referrer_waitlist_id], references: [id], onUpdate: NoAction)

  @@index([event_type], map: "idx_referral_events_event_type")
  @@index([referrer_profile_id], map: "idx_referral_events_referrer_profile")
  @@index([referrer_waitlist_id], map: "idx_referral_events_referrer_waitlist")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reward_catalog {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String                @unique
  name                String
  reward_system       String
  description         String
  is_redeemable       Boolean               @default(false)
  metadata            Json                  @default("{}")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  reward_entitlements reward_entitlements[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reward_entitlements {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_email            String
  waitlist_id           String?              @db.Uuid
  profile_id            String?              @db.Uuid
  reward_key            String
  source_event          String
  source_referral_count Int?
  status                String               @default("active")
  granted_at            DateTime             @default(now()) @db.Timestamptz(6)
  expires_at            DateTime?            @db.Timestamptz(6)
  metadata              Json                 @default("{}")
  profiles              profiles?            @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reward_catalog        reward_catalog       @relation(fields: [reward_key], references: [key], onUpdate: NoAction)
  waitlist              waitlist?            @relation(fields: [waitlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reward_redemptions    reward_redemptions[]

  @@unique([user_email, reward_key], map: "idx_reward_entitlements_email_key", where: raw("(status = ANY (ARRAY['active'::text, 'redeemed'::text]))"))
  @@index([profile_id], map: "idx_reward_entitlements_profile_id")
  @@index([waitlist_id], map: "idx_reward_entitlements_waitlist_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reward_redemptions {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entitlement_id          String              @db.Uuid
  profile_id              String?             @db.Uuid
  redemption_context      String
  redemption_reference_id String?
  redeemed_at             DateTime            @default(now()) @db.Timestamptz(6)
  metadata                Json                @default("{}")
  reward_entitlements     reward_entitlements @relation(fields: [entitlement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles                profiles?           @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model waitlist_rank_history {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  waitlist_id String   @db.Uuid
  rank        Int
  score       Int
  reason      String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  waitlist    waitlist @relation(fields: [waitlist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([waitlist_id], map: "idx_waitlist_rank_history_waitlist_id")
}

enum UserRole {
  user
  agent
  owner
  admin

  @@map("user_role")
}
