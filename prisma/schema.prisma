/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id                                                            String                @id @db.Uuid
  email                                                         String
  full_name                                                     String?
  avatar_url                                                    String?
  phone                                                         String?
  bio                                                           String?
  created_at                                                    DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                                                    DateTime?             @default(now()) @db.Timestamptz(6)
  referral_code                                                 String?               @unique @db.VarChar(20)
  referred_by                                                   String?               @db.Uuid
  referred_by_code                                              String?               @db.VarChar(20)
  referral_count                                                Int                   @default(0)
  waitlist_persona                                              String?
  candidate_role                                                String?
  role_activated_at                                             DateTime?             @db.Timestamptz(6)
  launch_reward_window_ends_at                                  DateTime?             @db.Timestamptz(6)
  admin_audit_log                                               admin_audit_log[]
  agents                                                        agents?
  email_campaigns                                               email_campaigns[]
  inquiries_inquiries_owner_idToprofiles                        inquiries[]           @relation("inquiries_owner_idToprofiles")
  inquiries_inquiries_sender_idToprofiles                       inquiries[]           @relation("inquiries_sender_idToprofiles")
  kyc_requests                                                  kyc_requests[]
  notifications                                                 notifications[]
  owners                                                        owners?
  payments                                                      payments[]
  referrer                                                      profiles?             @relation("ProfileReferrals", fields: [referred_by], references: [id])
  referrals                                                     profiles[]            @relation("ProfileReferrals")
  users                                                         users                 @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profiles_users_id_fkey")
  property_documents                                            property_documents[]
  referral_events_referral_events_referred_profile_idToprofiles referral_events[]     @relation("referral_events_referred_profile_idToprofiles")
  referral_events_referral_events_referrer_profile_idToprofiles referral_events[]     @relation("referral_events_referrer_profile_idToprofiles")
  reviews                                                       reviews[]
  reward_entitlements                                           reward_entitlements[]
  reward_redemptions                                            reward_redemptions[]
  saved_properties                                              saved_properties[]

  @@index([referral_code], map: "idx_profiles_referral_code")
  @@index([referred_by], map: "idx_profiles_referred_by")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
