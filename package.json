{
  "name": "realest-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start:app": "npx tsx scripts/start-app.ts",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run typecheck && npm run lint",
    "start": "next start",
    "test": "npx tsx --test scripts/start-app.test.ts scripts/migration-ledger.test.ts scripts/readme-install.test.ts lib/pg-ssl.test.ts lib/resend-key.test.ts lib/waitlist-join-rewards.test.ts lib/route-lockdown-analysis.test.ts scripts/lib/load-cli-env.test.ts lib/validation/ocr.test.ts lib/a01-write-path-boundary.test.ts lib/admin/a01-user-moderation.test.ts lib/auth/a01-require-admin.test.ts",
    "eval:start-app": "npx tsx evals/start-app/run.ts",
    "eval:waitlist-join-rewards": "npx tsx evals/waitlist-join-rewards/run.ts",
    "eval:route-lockdown": "npx tsx evals/route-lockdown/run.ts",
    "setup:branches": "bash scripts/setup-branch-management.sh",
    "check:deployment": "bash scripts/check-deployment.sh",
    "switch:develop": "bash scripts/switch-branch.sh develop",
    "switch:staging": "bash scripts/switch-branch.sh staging",
    "switch:main": "bash scripts/switch-branch.sh main",
    "dev:coming-soon": "NEXT_PUBLIC_APP_MODE=coming-soon npm run dev",
    "dev:full-site": "NEXT_PUBLIC_APP_MODE=full-site npm run dev",
    "dev:demo": "NEXT_PUBLIC_APP_MODE=development npm run dev",
    "test:lockdown": "npx tsx scripts/test-route-lockdown.ts",
    "test:validation": "npx tsx scripts/validation-smoke-test.ts",
    "create:local-admin": "npx tsx scripts/create-local-admin.ts",
    "ensure:local-buckets": "npx tsx scripts/ensure-local-storage-buckets.ts",
    "test:listing:e2e": "npx tsx scripts/full-listing-e2e.ts",
    "validation:worker": "npx tsx scripts/validation-worker.ts",
    "validation:worker:once": "npx tsx scripts/validation-worker.ts --once",
    "email:export": "npx react-email export --dir emails/templates",
    "email:dev": "npx react-email dev --dir emails/templates --port 3001",
    "icons:generate": "npx tsx scripts/generate-png-icons.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "audiences:seed": "npx tsx scripts/seed-resend-audiences.ts",
    "audiences:seed:dry": "npx tsx scripts/seed-resend-audiences.ts --dry-run",
    "docs:openapi": "curl -s http://localhost:3000/api/docs/openapi.json > openapi.json && echo 'OpenAPI spec exported to openapi.json'",
    "docs:view": "echo '🚀 Open API docs at: http://localhost:3000/api-docs (after running npm run dev)'",
    "scaffold:endpoint": "npx tsx scripts/scaffold-endpoint.ts",
    "generate:api-spec": "npx tsx scripts/generate-api-spec.ts",
    "docs:auto": "npm run generate:api-spec && npm run docs:openapi",
    "docs:generate": "npm run generate:api-spec",
    "prebuild": "npm run generate:api-spec",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --pretty false"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
