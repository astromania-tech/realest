# Copy this file to .env.local and replace every placeholder.
#   cp .env.example .env.local
# Or run ./start.sh and let it create .env.local for you.
#
# Required to boot the homepage:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for Prisma / API routes that hit the database:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Local app mode. development shows demo pages and enables auth.
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email. Routes that import lib/emailService.ts crash without this.
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=RealEST Connect <info@connect.realest.ng>
ADMIN_EMAIL=admin@your-domain.com

# Optional: maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token
