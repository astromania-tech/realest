# Copy this file to .env.local and replace every placeholder.
#   cp .env.example .env.local
# Or run ./start.sh and let it create .env.local for you.
#
# Required to boot the homepage:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for Prisma / API routes that hit the database.
# Use the Supabase pooler. User "postgres" on that host is rejected.
# Port 6543 is the pooler, not db.<project>.supabase.co.
# Vercel Production takes DATABASE_URL from the Doppler production sync.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Local app mode. development shows demo pages and enables auth.
# Signup and resend links use NEXT_PUBLIC_SITE_URL, then NEXT_PUBLIC_APP_URL.
# Set the deployed host in production, for example https://dev.realest.ng
NEXT_PUBLIC_APP_MODE=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email. Routes that import lib/emailService.ts crash without this.
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=RealEST Connect <info@connect.realest.ng>
ADMIN_EMAIL=admin@your-domain.com
# Local smoke / CLI login (optional). Not used for production deploy.
ADMIN_PASSWORD=

# Cloudflare Turnstile (waitlist bot check).
# Local without these keys: verify is skipped. Production / coming-soon without
# TURNSTILE_SECRET_KEY: waitlist POST fails closed (503).
# Create a widget at https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: signed waitlist unsubscribe tokens (falls back to service role key).
WAITLIST_UNSUBSCRIBE_SECRET=

# Optional: maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Youverify Identity. Owners submit NIN or BVN. Agents submit CAC.
# Unset base URL uses the sandbox host. Set the production host explicitly to bill live checks.
# The same secret signs webhook deliveries to POST /api/webhooks/youverify (header x-yv-signature).
YOUVERIFY_SECRET_KEY=
YOUVERIFY_BASE_URL=https://api.sandbox.youverify.co

# Trust reader service. Production runs the container in services/trust-reader.
# The image includes Tesseract and Poppler. Set a token whenever the host is not loopback.
TRUST_READER_URL=http://127.0.0.1:4078
TRUST_READER_TOKEN=
